{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "will-myers-webmcp",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-26",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "will-myers-webmcp.otis.solutions",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "ratelimits": [
    {
      "name": "PRODUCT_REFRESH_LIMITER",
      "namespace_id": "2791638241",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
