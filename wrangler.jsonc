{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "will-myers-webmcp",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-26",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "will-myers-webmcp.otis.solutions",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  }
}
